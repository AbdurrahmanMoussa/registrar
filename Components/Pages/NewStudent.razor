@page "/addstudent"
@rendermode InteractiveServer
@using Registrar
@inject NavigationManager Navigator

<PageTitle>Add Student</PageTitle>
<section class="container-fluid">
<StudentForm NewStudent="newStudent" StudentTypes="StudentTypes" OnCancel="NavigateToStudents" OnSubmit="OnSubmit"></StudentForm>
</section>

@code {
	Student newStudent = CreateStudent();
	public List<string> StudentTypes = Helper.GetStudentTypes();
	public static Student CreateStudent(){
		return new Student { Id = new Random().Next(1000, 9999) };
	}
	public void OnSubmit(){
		Helper.InitialStudents.Add(newStudent);
		newStudent = CreateStudent();
		Navigator.NavigateTo("/");
	}
	public void NavigateToStudents()
	{
		Navigator.NavigateTo("/");
	}
}
