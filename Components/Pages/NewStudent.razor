@page "/addstudent"
@rendermode InteractiveServer
@using Registrar
@inject NavigationManager Navigator

<PageTitle>Add Student</PageTitle>

<section class="container-fluid">
	<EditForm Model="newStudent">
		<h1>Add Student</h1>
		<div class="form-group">
			<label for="lastname">Last Name</label>
			<input type="text" id="lastname" class="form-control" placeholder="Last Name" @bind="newStudent.LastName" />
		</div>
		<div class="form-group">
			<label for="firstname">First Name</label>
			<input type="text" id="firstname" class="form-control" placeholder="First Name" @bind="newStudent.FirstName"/>
		</div>
		<div class="form-group">
			<label for="studenttype">Student Type</label>
			<select class="form-control" id="studenttype" @bind="newStudent.Type">
				<option disabled selected value="">Select a Student Type</option>
				@foreach(var type in StudentTypes){
					<option value="@type">@type</option>
				}

			</select>
		</div>
		<div class="form-group mt-3">
			<button type="button" class="btn btn-primary" @onclick="()=>OnSubmit()">Add Student</button>
			<button type="button" @onclick="NavigateToStudents" class="btn btn-danger">Cancel</button>
		</div>
	</EditForm>
</section>
@code {
	Student newStudent = CreateStudent();
	public List<string> StudentTypes = Helper.GetStudentTypes();
	public static Student CreateStudent(){
		return new Student { Id = new Random().Next(1000, 9999) };
	}
	public void OnSubmit(){
		Helper.InitialStudents.Add(newStudent);
		newStudent = CreateStudent();
		Navigator.NavigateTo("/");
	}
	public void NavigateToStudents()
	{
		Navigator.NavigateTo("/");
	}
}
