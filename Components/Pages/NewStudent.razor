@page "/addstudent"
@rendermode InteractiveServer
@using Registrar
@inject NavigationManager Navigator
@inject Registrar.Data.RegistrarDbContext context;

<PageTitle>Add Student</PageTitle>
<section class="container-fluid">
	<StudentForm NewStudent="newStudent" StudentTypes="StudentTypes" OnCancel="NavigateToStudents" OnSubmit="OnSubmitAsync"></StudentForm>
</section>

@code {
	Student newStudent = new Student();

	public List<string> StudentTypes = Helper.GetStudentTypes();

	public async Task OnSubmitAsync(){
		context.Student.Add(newStudent);
		await context.SaveChangesAsync();
		newStudent = new Student();
		await InvokeAsync(() => Navigator.NavigateTo("/"));
	}
	public void NavigateToStudents()
	{
		Navigator.NavigateTo("/");
	}
}
