@page "/"
@rendermode InteractiveServer
@using Registrar
@inject NavigationManager Navigator
<PageTitle>Students</PageTitle>
<main class="m-5">
	<header class="d-flex flex-column">
		<div class="w-100 border-bottom pb-2 mb-3 align-items-start">
			<h2>Student List</h2>
		</div>

		<a @onclick="NavigateToAddStudent" class="btn btn-primary rounded-1 align-self-end mw-100">+</a>
	</header>

	<section class="d-flex">

		<table class="table table-hover align-content-center border-5">
			<thead>
				<tr class="student-table">
					<th>ID</th>
					<th>Last Name</th>
					<th>First Name</th>
					<th>Type</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var student in students) 
				{
					<tr>
						<td>@student.Id</td>
						<td>@student.LastName</td>
						<td>@student.FirstName</td>
						<td>@student.Type</td>
						<td><button @onclick="()=>RegisterStudent(student.Id)" class="border-0 btn-primary color-white rounded-1 p-2">Register</button></td>
					</tr>
				}
			</tbody>
		</table>
	</section>
</main>
@code {

	List<Student> students = Helper.InitialStudents;

	private void RegisterStudent(int studentId)
	{
		Navigator.NavigateTo($"/register/{studentId}");
	}
	private void NavigateToAddStudent()
	{
		Navigator.NavigateTo("addstudent");
	}

}
